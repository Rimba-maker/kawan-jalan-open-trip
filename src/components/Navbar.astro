---
interface Props {
  active?: "home" | "nusantara" | "global";
}
const { active } = Astro.props;

const links = [
  { href: "/nusantara", label: "Nusantara", key: "nusantara" },
  { href: "/global", label: "Global", key: "global" },
  { href: "/#cerita-trip", label: "Cerita Trip" },
  { href: "/#faq", label: "FAQ" },
];

const ctaLabel = active === "home" || !active ? "Pilih Trip" : "Cek Jadwal Trip";
const ctaHref = active === "home" || !active ? "/#pilih-kategori" : "#jadwal-trip";
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-canvas/90 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="shrink-0 font-display text-lg font-extrabold tracking-tight text-ink">
      Kawan Jalan
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "text-sm font-semibold text-ink/80 transition-colors hover:text-ink",
              { "text-category-nusantara": link.key === "nusantara" && active === "nusantara" },
              { "text-category-global": link.key === "global" && active === "global" },
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={ctaHref}
      class="hidden shrink-0 rounded-pill bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary transition-transform active:scale-[0.98] lg:inline-block"
    >
      {ctaLabel}
    </a>

    <details class="lg:hidden">
      <summary class="flex h-9 w-9 cursor-pointer list-none flex-col items-center justify-center gap-1.5 [&::-webkit-details-marker]:hidden">
        <span class="block h-0.5 w-5 bg-ink"></span>
        <span class="block h-0.5 w-5 bg-ink"></span>
        <span class="block h-0.5 w-5 bg-ink"></span>
      </summary>
      <div class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b border-black/5 bg-canvas px-4 py-4 shadow-lg">
        {links.map((link) => (
          <a href={link.href} class="rounded-md px-3 py-2 text-sm font-semibold text-ink hover:bg-canvas-soft">
            {link.label}
          </a>
        ))}
        <a
          href={ctaHref}
          class="mt-2 rounded-pill bg-primary px-5 py-2.5 text-center text-sm font-semibold text-on-primary"
        >
          {ctaLabel}
        </a>
      </div>
    </details>
  </nav>
</header>
