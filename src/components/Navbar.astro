---
interface Props {
  active?: "home" | "nusantara" | "global";
}
const { active } = Astro.props;

const links = [
  { href: "/nusantara", label: "Nusantara", key: "nusantara" },
  { href: "/global", label: "Global", key: "global" },
  { href: "/#cerita-trip", label: "Cerita Trip" },
  { href: "/#faq", label: "FAQ" },
];

const ctaLabel = active === "home" || !active ? "Pilih Trip" : "Cek Jadwal Trip";
const ctaHref = active === "home" || !active ? "/#pilih-kategori" : "#jadwal-trip";
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-canvas/90 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="shrink-0 font-display text-lg font-extrabold tracking-tight text-ink">
      Kawan Jalan
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-semibold text-ink/80 transition-colors hover:text-ink"
            style={link.key === active ? { color: `var(--color-category-${link.key})` } : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={ctaHref}
      class="hidden shrink-0 rounded-pill bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary transition-transform active:scale-[0.98] lg:inline-block"
    >
      {ctaLabel}
    </a>

    <button
      type="button"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Buka menu"
      class="group flex h-9 w-9 shrink-0 items-center justify-center lg:hidden"
    >
      <span class="relative flex h-4 w-5 flex-col items-center justify-between">
        <span class="block h-0.5 w-5 origin-center bg-ink transition-transform duration-200 group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
        <span class="block h-0.5 w-5 bg-ink transition-opacity duration-150 group-aria-expanded:opacity-0"></span>
        <span class="block h-0.5 w-5 origin-center bg-ink transition-transform duration-200 group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
      </span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-30 bg-ink/40 opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden"
  aria-hidden="true"
></div>

<div
  id="mobile-menu"
  class="fixed inset-x-0 top-16 z-40 flex origin-top -translate-y-2 flex-col gap-1 rounded-b-2xl border-b border-black/5 bg-canvas p-4 opacity-0 shadow-xl transition-all duration-200 pointer-events-none lg:hidden"
>
  {links.map((link) => (
    <a
      href={link.href}
      class="rounded-md px-3 py-2.5 text-base font-semibold text-ink hover:bg-canvas-soft"
      style={link.key === active ? { color: `var(--color-category-${link.key})` } : undefined}
    >
      {link.label}
    </a>
  ))}
  <a
    href={ctaHref}
    class="mt-2 rounded-pill bg-primary px-5 py-3 text-center text-base font-semibold text-on-primary"
  >
    {ctaLabel}
  </a>
</div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const backdrop = document.getElementById("mobile-menu-backdrop")!;

  function openMenu() {
    toggle.setAttribute("aria-expanded", "true");
    menu.classList.remove("opacity-0", "-translate-y-2", "pointer-events-none");
    backdrop.classList.remove("opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    toggle.setAttribute("aria-expanded", "false");
    menu.classList.add("opacity-0", "-translate-y-2", "pointer-events-none");
    backdrop.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
  }

  toggle.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  backdrop.addEventListener("click", closeMenu);
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) closeMenu();
  });
</script>
