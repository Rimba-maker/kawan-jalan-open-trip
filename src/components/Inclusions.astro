---
interface Props {
  items: string[];
  excludesNote: string;
}
const { items, excludesNote } = Astro.props;
---
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
  <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink md:text-3xl">
    Semua Sudah Termasuk
  </h2>

  <div class="mt-8 rounded-card bg-canvas p-6 shadow-sm sm:p-8">
    <ul class="grid gap-3 sm:grid-cols-2">
      {items.map((item) => (
        <li class="flex items-start gap-2 text-sm text-body">
          <svg
            class="mt-0.5 h-4 w-4 shrink-0 text-positive"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
    <p class="mt-6 border-t border-black/5 pt-4 text-xs italic text-body">{excludesNote}</p>
  </div>
</section>
